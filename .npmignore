# Exclude all of src/ except the Vue single-file component, which is consumed
# directly by Vue users via the `./vue` export and must ship in the package.
src/*
!src/vue
!src/vue/**

*.config.js
*.config.ts
tsconfig.json
node_modules/
*.log
.DS_Store
.vscode/
.idea/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
examples/

